		displayFolder: Indicadores reproducibles
		lineageTag: d52cd2fb-ad31-4335-b569-da742bc85e46

	measure 'Tasa Carrera' = DIVIDE([N Carrera],[N Base])
		formatString: 0.0%
		displayFolder: Indicadores reproducibles
		lineageTag: fa618798-e1fe-4bf1-aed5-898deb1ef337

	measure 'Tasa Institucion' = DIVIDE([N Institucion],[N Base])
