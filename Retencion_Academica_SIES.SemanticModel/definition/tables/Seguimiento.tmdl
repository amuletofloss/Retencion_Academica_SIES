	partition Seguimiento = m
		mode: import
		source =
				let
					Files = Folder.Files(#"Ruta datos"),
					Selected = Table.SelectRows(Files, each Text.StartsWith([Name], "seguimiento_") and Text.EndsWith([Name], ".csv.gz")),
					Parsed = Table.AddColumn(Selected, "Rows", each Table.PromoteHeaders(Csv.Document(Binary.Decompress([Content], Compression.GZip), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])),
					Combined = Table.Combine(Parsed[Rows]),
					Types = Table.TransformColumnTypes(Combined,{{"MRUN",type text},{"TrayectoriaID",type text},{"ProgramaID",type text},{"Cohorte",Int64.Type},{"AnioObservado",Int64.Type},{"AnioDesdeIngreso",Int64.Type},{"Observable",Int64.Type},{"EnCarrera",Int64.Type},{"EnInstitucion",Int64.Type},{"EnEducacionSuperior",Int64.Type},{"EnECS",Int64.Type},{"MovilidadInternaECS",Int64.Type},{"TituladoAcumulado",Int64.Type}},"en-US")
				in Types

