table Seguimiento
	lineageTag: 3a3488c9-1ca0-4dce-8286-5588feae7967

	measure 'N Base' =
			VAR _contextoValido=HASONEVALUE('Cohortes'[Cohorte]) && HASONEVALUE('Horizontes'[AnioDesdeIngreso])
			RETURN IF(_contextoValido,DISTINCTCOUNT('Seguimiento'[TrayectoriaID]))
		formatString: #,##0
		displayFolder: Indicadores reproducibles
		lineageTag: 4a5d6618-cd76-4b33-b226-9c800f3b9850

	measure 'N Carrera' =
			VAR _contextoValido=HASONEVALUE('Cohortes'[Cohorte]) && HASONEVALUE('Horizontes'[AnioDesdeIngreso])
			RETURN IF(_contextoValido,CALCULATE(DISTINCTCOUNT('Seguimiento'[TrayectoriaID]),'Seguimiento'[EnCarrera]=1))
		formatString: #,##0
		displayFolder: Indicadores reproducibles
		lineageTag: 4f6eff7a-5037-477f-b8e9-3b0e143377c4

	measure 'N Institucion' =
			VAR _contextoValido=HASONEVALUE('Cohortes'[Cohorte]) && HASONEVALUE('Horizontes'[AnioDesdeIngreso])
			RETURN IF(_contextoValido,CALCULATE(DISTINCTCOUNT('Seguimiento'[TrayectoriaID]),'Seguimiento'[EnInstitucion]=1))
		formatString: #,##0
		displayFolder: Indicadores reproducibles
		lineageTag: 01974cb3-8a16-4305-bf35-3ab09ff57b2e

	measure 'N Educacion Superior' =
			VAR _contextoValido=HASONEVALUE('Cohortes'[Cohorte]) && HASONEVALUE('Horizontes'[AnioDesdeIngreso])
			RETURN IF(_contextoValido,CALCULATE(DISTINCTCOUNT('Seguimiento'[TrayectoriaID]),'Seguimiento'[EnEducacionSuperior]=1))
