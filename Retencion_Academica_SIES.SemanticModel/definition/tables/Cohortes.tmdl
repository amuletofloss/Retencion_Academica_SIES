table Cohortes
	lineageTag: ede01a12-79fd-400f-977f-4e353f929fd4

	column Cohorte
		dataType: int64
		lineageTag: 0954ea9f-259b-486c-abb0-94de126791ff
		summarizeBy: none
		sourceColumn: Cohorte

	partition Cohortes = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(#"Ruta datos" & "/cohortes.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Types = Table.TransformColumnTypes(Headers,{{"Cohorte",Int64.Type}},"en-US")
				in Types

